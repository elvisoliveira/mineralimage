<div id="block-views-UltimosTrabalhos-block_{{ id }}" class="block block-views">
	<div class="content">
		<div class="view view-UltimosTrabalhos view-id-UltimosTrabalhos view-display-id-block_{{ id }} ultimos-trabalhos view-dom-id-{{ id + 1  }}">
			<div class="view-content">
				<ul class="listagem-nodes">
					<li class="field-items first last odd">
						<div class="views-field-field-fotos-fid">
							<div class="field-content">
								{% for key, item in data %}
									<div class="field-item field-item-{{ loop.index - 1 }}">
										<a href="{{ files }}/{{ cached('Categorias-Large', key) }}" rel="lightbox[field_fotos_{{ tag }}][{{ item }}]" class="{{ classes | join(' ') }}">
											<img src="{{ files }}/{{ cached('Categorias-Thumb', key) }}" alt="{{ item }}" title="" width="100" height="100"/>
										</a>
									</div>
								{% endfor %}
							</div>
						</div>
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>
